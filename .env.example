# Public application metadata
APP_NAME=Index Canada
APP_ID=ca.indexcanada.app
APP_ENVIRONMENT=development
VERSION=1.0.0
BUILD_NUMBER=1

# Runtime endpoints and public client identifiers
API_BASE_URL=https://example.wixsite.com/_functions
FIREBASE_PROJECT_ID=replace_me
FIREBASE_API_KEY=replace_me

# Les builds mobiles utilisent StoreKit/Google Play Billing. Ne jamais y
# embarquer de clé Stripe. Les secrets Wix, Apple, Google et Stripe Web/legacy
# appartiennent au gestionnaire de secrets du backend.

# Feature controls
ENABLE_DEBUG_LOGGING=false
ENABLE_CRASH_REPORTING=false
ENABLE_ANALYTICS=false
IMAGE_CACHE_MAXIMUM_SIZE=200
IMAGE_CACHE_MAXIMUM_SIZE_BYTES=52428800

# Store and support metadata
GOOGLE_PLAY_CONSOLE_ID=replace_me
APPLE_DEVELOPER_TEAM_ID=replace_me
SUPPORT_EMAIL=support@example.com
PRIVACY_POLICY_URL=https://www.immigrantindex.com/privacy
# URL des conditions propres à Index Canada à publier avant la soumission.
TERMS_OF_SERVICE_URL=https://example.com/terms
FACEBOOK_APP_ID=replace_me
GOOGLE_ANALYTICS_ID=replace_me
